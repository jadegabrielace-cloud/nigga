--  CONFIG
-- ══════════════════════════════════════════
local CFG = {
    FlySpeed     = 80,
    FlingForce   = 950000,
    FlyEnabled   = false,
    LoopFling    = false,
    FlingTarget  = "",
    SpeedEnabled = false,
    SpeedValue   = 60,
    NoclipOn     = false,
    InfJumpOn    = false,
}

-- ══════════════════════════════════════════
--  HELPERS
-- ══════════════════════════════════════════
local function getChar(p)  return p and p.Character end
local function getRoot(p)  local c=getChar(p) return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum(p)   local c=getChar(p) return c and c:FindFirstChildOfClass("Humanoid") end
local function findPlayer(name)
    name = name:lower()
    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Name:lower():find(name) then return p end
    end
end

-- ══════════════════════════════════════════
--  FLY
-- ══════════════════════════════════════════
local flyConn, bVel, bGyro

local function stopFly()
    CFG.FlyEnabled = false
    if flyConn then flyConn:Disconnect() flyConn=nil end
    if bVel    then bVel:Destroy()    bVel=nil    end
    if bGyro   then bGyro:Destroy()   bGyro=nil   end
    local h=getHum(lp) if h then h.PlatformStand=false end
end

local function startFly()
    stopFly()
    local root=getRoot(lp) if not root then return end
    CFG.FlyEnabled=true
    bVel=Instance.new("BodyVelocity")
    bVel.MaxForce=Vector3.new(1e5,1e5,1e5) bVel.Velocity=Vector3.zero bVel.Parent=root
    bGyro=Instance.new("BodyGyro")
    bGyro.MaxTorque=Vector3.new(1e5,1e5,1e5) bGyro.D=100 bGyro.Parent=root
    local h=getHum(lp) if h then h.PlatformStand=true end
    flyConn=RunService.RenderStepped:Connect(function()
        if not CFG.FlyEnabled then return end
        local dir=Vector3.zero
        local ks=UserInputService.IsKeyDown
        if ks(UserInputService,Enum.KeyCode.W)          then dir=dir+cam.CFrame.LookVector  end
        if ks(UserInputService,Enum.KeyCode.S)          then dir=dir-cam.CFrame.LookVector  end
        if ks(UserInputService,Enum.KeyCode.A)          then dir=dir-cam.CFrame.RightVector end
        if ks(UserInputService,Enum.KeyCode.D)          then dir=dir+cam.CFrame.RightVector end
        if ks(UserInputService,Enum.KeyCode.Space)      then dir=dir+Vector3.new(0,1,0)     end
        if ks(UserInputService,Enum.KeyCode.LeftShift)  then dir=dir-Vector3.new(0,1,0)     end
        bVel.Velocity = dir.Magnitude>0 and dir.Unit*CFG.FlySpeed or Vector3.zero
        bGyro.CFrame  = cam.CFrame
    end)
end

-- ══════════════════════════════════════════
--  FLING
-- ══════════════════════════════════════════
local flingLoop

local function doFling(target)
    local myRoot=getRoot(lp) local tRoot=getRoot(target)
    if not myRoot or not tRoot then return end
    myRoot.CFrame=tRoot.CFrame*CFrame.new(0,0,-1.5)
    local bv=Instance.new("BodyVelocity")
    bv.MaxForce=Vector3.new(CFG.FlingForce,CFG.FlingForce,CFG.FlingForce)
    bv.Velocity=(tRoot.CFrame.LookVector+Vector3.new(0,1,0)).Unit*CFG.FlingForce
    bv.Parent=tRoot
    game:GetService("Debris"):AddItem(bv,0.12)
end

local function stopLoopFling()
    CFG.LoopFling=false
    if flingLoop then flingLoop:Disconnect() flingLoop=nil end
end

local function startLoopFling()
    stopLoopFling()
    CFG.LoopFling=true
    flingLoop=RunService.Heartbeat:Connect(function()
        if not CFG.LoopFling then return end
        local t=findPlayer(CFG.FlingTarget)
        if t then doFling(t) end
    end)
end

-- ══════════════════════════════════════════
--  SPEED
-- ══════════════════════════════════════════
local speedConn

local function stopSpeed()
    CFG.SpeedEnabled=false
    if speedConn then speedConn:Disconnect() speedConn=nil end
    local h=getHum(lp) if h then h.WalkSpeed=16 end
end

local function startSpeed()
    stopSpeed()
    CFG.SpeedEnabled=true
    speedConn=RunService.Heartbeat:Connect(function()
        local h=getHum(lp)
        if h then h.WalkSpeed=CFG.SpeedValue end
    end)
end

-- ══════════════════════════════════════════
--  NOCLIP
-- ══════════════════════════════════════════
local noclipConn

local function stopNoclip()
    CFG.NoclipOn=false
    if noclipConn then noclipConn:Disconnect() noclipConn=nil end
end

local function startNoclip()
    stopNoclip()
    CFG.NoclipOn=true
    noclipConn=RunService.Stepped:Connect(function()
        local c=getChar(lp)
        if not c then return end
        for _,p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide=false end
        end
    end)
end

-- ══════════════════════════════════════════
--  INF JUMP
-- ══════════════════════════════════════════
local jumpConn

local function stopInfJump()
    CFG.InfJumpOn=false
    if jumpConn then jumpConn:Disconnect() jumpConn=nil end
end

local function startInfJump()
    stopInfJump()
    CFG.InfJumpOn=true
    jumpConn=UserInputService.JumpRequest:Connect(function()
        local h=getHum(lp)
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end)
end

