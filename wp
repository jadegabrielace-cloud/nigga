-- ── TAB SYSTEM ──────────────────────────────────
local tabs       = {}
local tabBtns    = {}
local activeTab  = nil

local function selectTab(name)
    for n,frame in pairs(tabs) do
        frame.Visible = (n==name)
    end
    for n,btn in pairs(tabBtns) do
        btn.BackgroundColor3 = (n==name) and COLORS.tabsel or COLORS.tab
        btn.TextColor3       = (n==name) and Color3.new(1,1,1) or COLORS.sub
    end
    activeTab=name
end

